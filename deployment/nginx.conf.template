server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Runtime configuration. The nginx entrypoint expands ${VITE_*} when it renders this template into
    # /etc/nginx/conf.d/default.conf at container start (NGINX_ENVSUBST_FILTER limits that to VITE_*, so nginx's own
    # variables like $uri stay untouched). sub_filter then writes the values into the placeholder data-* attributes of
    # index.html on every request, where src/lib/runtimeEnv.ts reads them.
    sub_filter 'data-vite-park-api-url="VITE_PARK_API_URL"'                       'data-vite-park-api-url="${VITE_PARK_API_URL}"';
    sub_filter 'data-vite-map-style-url="VITE_MAP_STYLE_URL"'                     'data-vite-map-style-url="${VITE_MAP_STYLE_URL}"';
    sub_filter 'data-vite-operator-name="VITE_OPERATOR_NAME"'                     'data-vite-operator-name="${VITE_OPERATOR_NAME}"';
    sub_filter 'data-vite-operator-address="VITE_OPERATOR_ADDRESS"'               'data-vite-operator-address="${VITE_OPERATOR_ADDRESS}"';
    sub_filter 'data-vite-operator-email="VITE_OPERATOR_EMAIL"'                   'data-vite-operator-email="${VITE_OPERATOR_EMAIL}"';
    sub_filter 'data-vite-operator-phone="VITE_OPERATOR_PHONE"'                   'data-vite-operator-phone="${VITE_OPERATOR_PHONE}"';
    sub_filter 'data-vite-operator-representative="VITE_OPERATOR_REPRESENTATIVE"' 'data-vite-operator-representative="${VITE_OPERATOR_REPRESENTATIVE}"';
    sub_filter 'data-vite-operator-register="VITE_OPERATOR_REGISTER"'             'data-vite-operator-register="${VITE_OPERATOR_REGISTER}"';
    sub_filter 'data-vite-operator-vat-id="VITE_OPERATOR_VAT_ID"'                 'data-vite-operator-vat-id="${VITE_OPERATOR_VAT_ID}"';
    sub_filter_once off;
    sub_filter_last_modified on;

    # add_header is not inherited by a location that has an add_header of its own, so each location states them all.

    # Client-side routing: every path that is not a file is a page of the app.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Vite puts a content hash into every file name below /assets, so these never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;

        # MapLibre's worker is an ES module, which browsers only run if it is served as JavaScript. The mime.types of
        # nginx know no .mjs, and a `types` block would replace that whole map rather than extend it.
        location ~ \.mjs$ {
            types {}
            default_type text/javascript;
        }
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;
    gzip_min_length 1024;
}
