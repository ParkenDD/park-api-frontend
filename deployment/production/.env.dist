# Configuration of the production deployment: copy to `.env` and fill in. Lines marked `# required` have no default.

# --- Image ----------------------------------------------------------------------------------------------------------
# Where .github/workflows/build.yml publishes the image: the GitHub repository, in lower case. The tag is a git tag
# verbatim, or `dev` for the current state of main. There is no `latest`: pin a git tag.
# required
IMAGE=ghcr.io/parkendd/park-api-frontend
# required
IMAGE_TAG=

# --- Traefik --------------------------------------------------------------------------------------------------------
# required
DOMAIN=parkapi.example.org
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Prefixes the container and the Traefik router name, so a second installation on the same Traefik needs another one.
COMPOSE_PROJECT_NAME=park-api-frontend
TZ=Europe/Berlin

# --- ParkAPI and map ------------------------------------------------------------------------------------------------
# Base URL of the ParkAPI instance, without trailing slash. It has to serve /api/public/v3/tiles.
# required
VITE_PARK_API_URL=https://api.mobidata-bw.de/park-api
VITE_MAP_STYLE_URL=https://tiles.binary-butterfly.de/osm-bright-gl-style/style.json

# --- Operator -------------------------------------------------------------------------------------------------------
# Who runs this website, as the imprint (§ 5 DDG) and the privacy policy state it. The address is split into lines
# at its commas. Empty optional values leave their line out of the imprint.
# required
VITE_OPERATOR_NAME=
# required
VITE_OPERATOR_ADDRESS=
# required
VITE_OPERATOR_EMAIL=
VITE_OPERATOR_PHONE=
VITE_OPERATOR_REPRESENTATIVE=
VITE_OPERATOR_REGISTER=
VITE_OPERATOR_VAT_ID=
