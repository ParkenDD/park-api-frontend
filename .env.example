# Copy to `.env` to override the defaults in `npm run dev`. In the container image, the same names are read from the
# environment at request time instead (see deployment/nginx.conf.template and src/lib/runtimeEnv.ts).

# Base URL of the ParkAPI instance, without trailing slash. A local park-api dev setup runs at http://localhost:5000.
VITE_PARK_API_URL=https://api.park-api.de

# MapLibre style of the base map.
VITE_MAP_STYLE_URL=https://tiles.binary-butterfly.de/osm-bright-gl-style/style.json

# Photon geocoder for the place search of the map, empty to turn it off. geocode.park-api.de allows CORS for
# park-api.de only, so locally it is reached through the proxy of the dev server (see vite.config.ts).
VITE_GEOCODER_URL=/geocode

# Operator of this website, used in the imprint and the privacy policy.
VITE_OPERATOR_NAME="binary butterfly GmbH"
VITE_OPERATOR_ADDRESS="Am Hertinger Tor 1, 59423 Unna"
VITE_OPERATOR_EMAIL="ernesto.ruge@binary-butterfly.de"
VITE_OPERATOR_PHONE="+49 2303 6766916"
VITE_OPERATOR_REPRESENTATIVE="Ernesto Ruge"
VITE_OPERATOR_REGISTER="Amtsgericht Hamm, HRB 9654"
VITE_OPERATOR_VAT_ID="DE323570669"
